SELECT ?i ?id ?de ?en ?coord ?iso ?krit ?typ ?start WHERE {
  ?i wdt:P757 ?id .
  OPTIONAL { ?i rdfs:label ?de FILTER(lang(?de)="de") }
  OPTIONAL { ?i rdfs:label ?en FILTER(lang(?en)="en") }
  OPTIONAL { ?i wdt:P625 ?coord }
  OPTIONAL { ?i wdt:P17/wdt:P298 ?iso }
  OPTIONAL { ?i wdt:P2614 ?krit }
  OPTIONAL { ?i wdt:P31 ?typ }
  OPTIONAL { ?i p:P1435 ?st . ?st ps:P1435 wd:Q9259 . OPTIONAL { ?st pq:P580 ?start } }
}
